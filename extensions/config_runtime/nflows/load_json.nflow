@description "Load a structured JSON config at runtime and validate its nested service settings"
@schema ConnectionPool {
  min! int `validate:"gte=1"`
  max! int `validate:"gte=1"`
}
@schema DatabaseSettings {
  host! string
  pool! ConnectionPool
}
@schema AppSettings {
  service! string
  port! int `validate:"gte=1,lte=65535"`
  enabled! bool
  features! []string `validate:"min=1,dive,required"`
  database! DatabaseSettings
}
{}
  -> config_runtime.load (path: "settings.json")
  -> AppSettings.validate

@assert {
  service == "payments"
  port == 8443
  enabled == true
  len(features) == 2
  database.host == "db.internal"
  database.pool.min == 2
  database.pool.max == 12
}
