@description "Load a YAML web-service config at runtime and validate its nested TLS settings"
@require config_yaml
@schema TLSSettings {
  mode! string
  ciphers! []string `validate:"min=1,dive,required"`
}
@schema WebSettings {
  host! string
  port! int `validate:"gte=1,lte=65535"`
  enabled! bool
  tls! TLSSettings
}
{}
  -> config_runtime.load (path: "settings.yml")
  -> WebSettings.validate

@assert {
  host == "api.example.test"
  port == 8443
  enabled == true
  tls.mode == "strict"
  tls.ciphers[0] == "modern"
  tls.ciphers[1] == "approved"
}
