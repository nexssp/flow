@description "Count stream records and total their character lengths with stream.fold"
cov.items
  -> stream.fold ( initial: { count: 0, characters: 0 }, expression: "{ count: acc.count + 1, characters: acc.characters + len(item) }" )
  -> collect

@assert {
  len(result) == 1
  result[0].count == 3
  result[0].characters == 18
}
