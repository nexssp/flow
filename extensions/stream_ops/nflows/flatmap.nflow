@description "Expand each item in place with stream.flatMap"
cov.items
  -> stream.flatMap ( expression: "[item, item]" )
  -> collect

@assert {
  len(result) == 6
  result[0] == "item_1"
  result[1] == "item_1"
  result[2] == "item_2"
  result[3] == "item_2"
  result[4] == "item_3"
  result[5] == "item_3"
}
