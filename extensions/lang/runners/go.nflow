{
    "_comment": "Go single-file runner. `go run` compiles and executes the materialized source.",
    "id": "go",
    "ext": ".go",
    "aliases": ["go", "golang"],
    "find": ["go run"],
    "stdin": "json",
    "stdout": "json",
    "file_template": "package main\n\nimport (\n\t\"encoding/json\"\n\t\"os\"\n)\n\nfunc main() {\n\tvar input any\n\tif err := json.NewDecoder(os.Stdin).Decode(&input); err != nil {\n\t\tpanic(err)\n\t}\n\n\toutput := input // TODO: transform input\n\n\tif err := json.NewEncoder(os.Stdout).Encode(output); err != nil {\n\t\tpanic(err)\n\t}\n}\n",
    "install": {
        "windows": ["winget", "install", "GoLang.Go"],
        "darwin": ["brew", "install", "go"]
    }
}
