{
    "_comment": "Python 3. PEP 723 scripts use uv when the marker is present.",
    "id": "python",
    "version": "3",
    "ext": ".py",
    "aliases": ["py3", "python3"],
    "find": ["python3", "py -3"],
    "stdin": "json",
    "stdout": "json",
    "file_template": "import json\nimport sys\n\ninput_value = json.load(sys.stdin)\noutput_value = input_value  # TODO: transform input\njson.dump(output_value, sys.stdout, separators=(\",\", \":\"))\nsys.stdout.write(\"\\n\")\n",
    "deps": "uv run {file}",
    "deps_marker": "# /// script",
    "install": {
        "windows": ["winget", "install", "Python.Python.3.12"],
        "darwin": ["brew", "install", "python@3.12"]
    }
}
