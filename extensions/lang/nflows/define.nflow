@description "User-defined language via @lang.define."
@require lang

# Registers an inline alias to Python, then invokes it. The self-test runner
# skips this fixture when Python 3 is not installed.
@lang.define "inlinepy" {
    "id": "inlinepy",
    "ext": ".py",
    "aliases": ["inlinepy"],
    "find": ["python3"],
    "stdin": "json",
    "stdout": "text"
}

@assert: result == "ok"
{ "value": "hello" } -> inlinepy"import sys; sys.stdout.write('ok')"
