@description "User-defined language via @lang.define."
@require lang

# Registers an inline alias to Python, then invokes it. Use the same lookup
# candidates as the built-in Python runner; self-test skips only when none exist.
@lang.define "inlinepy" {
    "id": "inlinepy",
    "ext": ".py",
    "aliases": ["inlinepy"],
    "find": ["python3", "python", "py -3"],
    "stdin": "json",
    "stdout": "text"
}

@assert: result == "ok"
{ "value": "hello" } -> inlinepy"import sys; sys.stdout.write('ok')"
