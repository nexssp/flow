@description "Read sorted local NFlow source files as bytes and concatenate them without changing byte order"
@require fs

@schema ByteConcatResult {
  content! string
}

@pipeline concat_sources(): !ByteConcatResult
  fs.walk (dir: "extensions/bytes/nflows", ext: "nflow")
    -> fs.sort
    -> fs.read
    -> stream.map (expression: "item.Content")
    -> collect
    -> bytes.concat
    -> { content: . }
@end

pipeline.concat_sources

@assert {
  len(content) > 0
}
