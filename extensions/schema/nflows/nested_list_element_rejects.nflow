@description "spec: []Schema elements are recursively checked as nested objects"
@schema Candidate {
  id! string
}
@schema Request {
  candidates! []Candidate `validate:"min=1,dive,required"`
}
{ candidates: ["not-an-object"] }
-> Request.validate ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: rejected == true
