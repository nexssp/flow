@description "spec: explicitly typed symbols provide native schema defaults and type-directed validation operands"
@symbols constraints {
  status: int = 201;
  timeout: duration = 5s;
  label: string = "created"
}
@schema TypedRequest {
  status  int `default:"constraints.status" validate:"eq=constraints.status"`
  timeout time.Duration `default:"constraints.timeout" validate:"gte=constraints.timeout"`
  label   string `default:"constraints.label" validate:"oneof=constraints.label"`
}
{}
  -> TypedRequest.validate

@assert {
  status == 201
  label == "created"
  timeout != nil
}
