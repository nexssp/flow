@description "validate=oneof rejects a value outside the declared set"
@schema Priority {
  level! string `validate:"oneof=low medium high"`
}
@assert: status == "rejected"
{ level: "urgent" }
  -> Priority.validate ? on_error {
    xerr.KindValidation
    -> { status: "rejected" },
    else
    -> { status: "unexpected" }
  }
