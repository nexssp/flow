@description "validate=dive,gt=0 rejects a non-positive array element"
@schema OrderBatch {
  amounts! []int `validate:"min=1,dive,gt=0"`
}
@assert: status == "rejected"
{ amounts: [10, 0, 99] }
  -> OrderBatch.validate ? on_error {
    xerr.KindValidation
    -> { status: "rejected" },
    else
    -> { status: "unexpected" }
  }
