@description "spec: nested @schema fields enforce required markers recursively"
@schema Attempt {
  AttemptID! string `json:"attempt_id"`
}
@schema Candidate {
  Attempt! Attempt `json:"attempt"`
}
{ attempt: {} }
-> Candidate.validate ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: result.rejected == true
