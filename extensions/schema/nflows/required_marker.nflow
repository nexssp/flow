@description "Schema required markers validate key presence independently of value constraints"

@schema Customer {
  name! string
}

@schema Request {
  customer! Customer
  labels! []string `validate:"min=1,max=15,dive,required"`
  note string `validate:"min=1"`
}

@pipeline validate_request(request: Request)
  schema.validate ( name: "Request" )
@end

{ customer: { name: "" }, labels: ["present"] }
  -> pipeline.validate_request
