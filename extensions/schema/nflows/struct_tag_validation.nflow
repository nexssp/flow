@description "Schema validates numeric bounds, array element rules, and json wire names"

@schema OrderBatch {
  batch_ref! string
  amounts! []int `validate:"min=1,max=15,dive,gt=0"`
  limit    float64 `default:"1000.50" validate:"gt=0"`
}

{
  batch_ref: "REF-2026",
  amounts:   [10, 25, 99]
}
-> OrderBatch.validate

@assert {
  batch_ref == "REF-2026"
  len(amounts) == 3
  limit == 1000.50
}
