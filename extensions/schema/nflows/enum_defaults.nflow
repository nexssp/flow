@description "spec: closed enum members resolve to wire strings, defaults and oneof are exact, and enum membership is automatic"
@enum OrderStatus {
  pending
  paid = "settled"
  canceled = "canceled_by_user"
  unicode = "\u{41}"
  byte = "\xff"
}
@schema Order {
  status OrderStatus `default:"OrderStatus.pending"`
  refund_status! OrderStatus `validate:"oneof=OrderStatus.paid OrderStatus.canceled"`
  unicode_status OrderStatus `default:"OrderStatus.unicode"`
  byte_status OrderStatus `default:"OrderStatus.byte"`
}
{ status: OrderStatus.paid, refund_status: OrderStatus.canceled }
  -> Order.validate

@assert {
  status == "settled"
  refund_status == "canceled_by_user"
  unicode_status == "A"
  byte_status == "ÿ"
}
