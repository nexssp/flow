@description "Projection: reuse ordered local calculations and default optional data"
@assert: result.id == "C-42"
@assert: result.eligible_count == 2
@assert: result.subtotal_minor == 320
@assert: result.discount_minor == 0
@assert: result.total_minor == 320
@assert: result.eligible_skus[0] == "BOOK-1"
@assert: result.eligible_skus[1] == "PEN-2"
{
  customer: { id: "C-42" },
  discount_minor: null,
  orders: [
    { sku: "BOOK-1", unit_minor: 120, quantity: 2 },
    { sku: "PEN-2", unit_minor: 80, quantity: 1 },
    { sku: "VOID-0", unit_minor: 999, quantity: 0 }
  ]
}
-> {
  let eligible = .orders | filter(#.quantity > 0);
  let line_totals = eligible | map(#.unit_minor * #.quantity);
  .customer.id,
  eligible_count: len(eligible),
  subtotal_minor: sum(line_totals),
  discount_minor: .discount_minor ?? 0,
  total_minor: sum(line_totals) - (.discount_minor ?? 0),
  eligible_skus: eligible | map(#.sku)
}
