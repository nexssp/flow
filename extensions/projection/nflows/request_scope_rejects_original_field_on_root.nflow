@description "current root does not acquire original-request fields"
# @expect-compile-error request
@schema Request {
  request! string
}
@pipeline request_scope_rejects_original_field_on_root(request: Request)
  cov.typed_projection
  -> { invalid: __root__.request }
@end
{ request: "original request" }
-> pipeline.request_scope_rejects_original_field_on_root
