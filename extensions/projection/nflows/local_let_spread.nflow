@description "spec: projection-local lets coexist with spread and shorthand"
{
  name: "Ada",
  status: "new",
  profile: {
    name: "Ada Lovelace"
  },
  extra: "preserved"
}
-> {
  let profile = .profile;
  ...,
  name,
  display: profile.name,
  status: "active"
}

@assert {
  name == "Ada"
  display == "Ada Lovelace"
  status == "active"
  extra == "preserved"
}
