@description "spec: explicit input paths and object shorthand remain valid around an overlapping pipeline binding"
@assert: result.name == "current"
@assert: result.original == "original"
@assert: result.tool.name == "current"
@pipeline explicit_binding_disambiguation
  const( name: "bound" ) as tool
  -> const( tool: { name: "current" } )
  -> {
    .tool.name,
    original: input.tool.name,
    tool
  }
@end
const( tool: { name: "original" } )
  -> pipeline.explicit_binding_disambiguation
