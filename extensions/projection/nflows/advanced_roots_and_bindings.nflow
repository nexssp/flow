@description "Projection: distinguish current input, original request, and pipeline bindings"
@pipeline advanced_roots_and_bindings
  { tool: { name: "bound" }, stage: "bound-stage" } as previous
  -> { tool: { name: "current" }, stage: "current-stage" }
  -> {
    current_tool: .tool.name,
    original_tool: input.tool.name,
    tool,
    current_stage: .stage,
    original_request_id: input.request_id,
    previous_tool: previous.tool.name
  }
@end
{ request_id: "REQ-17", tool: { name: "original" }, stage: "request-stage" }
-> pipeline.advanced_roots_and_bindings

@assert {
  current_tool == "current"
  original_tool == "original"
  tool.name == "current"
  current_stage == "current-stage"
  original_request_id == "REQ-17"
  previous_tool == "bound"
}
