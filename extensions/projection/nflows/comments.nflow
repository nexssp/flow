@description "Projection: hash comments are stripped before expr-lang compiles"
@assert: result.name == "Julia"
@assert: result.extra == 1
@assert: result.filtered == ["alpha", "gamma"]
@assert: result.coalesced == ["fallback", "present"]
@assert: result.conditional == ["yes", "no"]
{
  name: "Julia",
  extra: 1,
  items: [{ field: "alpha" }, { field: "beta" }],
  labels: ["alpha", "beta", "gamma"],
  nullable: [null, "present"],
  flags: [true, false]
}
-> {
  # leading comment
  name: .name,  # trailing comment
  extra: .extra,
  optional: .items | map(
    #?.field
  ),
  filtered: .labels | filter(
    # != "beta"
  ),
  coalesced: .nullable | map(
    # ?? "fallback"
  ),
  conditional: .flags | map(
    # ? "yes" : "no"
  )
}
