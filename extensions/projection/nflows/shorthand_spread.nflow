@description "spec: projection shorthand with spread"

{
  name: "Ada",
  email: "ada@example.test",
  status: "pending",
  version: 1,
  extra: "preserved"
}
-> {
  ...,
  name,
  email,
  status: "active",
  version: .version + 1
}

@assert {
  name == "Ada"
  email == "ada@example.test"
  status == "active"
  version == 2
  extra == "preserved"
}
