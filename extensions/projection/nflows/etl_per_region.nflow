@description "ETL: filter, aggregate per-region, keep audit counts"

# Extract: the batch arrives as payload.
# Transform: keep orders above a threshold, group by region, sum amounts.
# Load: emit per-region totals plus a dropped-record count for audit.
#
# Every expression below is expr-lang: filter, map, sum, len. No glue
# actions, no intermediate structs, no manual bookkeeping.

@assert: result.eu.total == 250
@assert: result.eu.count == 2
@assert: result.us.total == 400
@assert: result.us.count == 2
@assert: result.dropped == 1

{
  orders: [
    { id: 1, region: "eu", amount: 100 },
    { id: 2, region: "us", amount: 200 },
    { id: 3, region: "eu", amount: 150 },
    { id: 4, region: "us", amount: 200 },
    { id: 5, region: "eu", amount: 10 },
  ],
}
-> {
  valid: orders | filter(#.amount >= 50),
  total: len(orders),
}
-> {
  eu: {
    total: sum(valid | filter(#.region == "eu") | map(#.amount)),
    count: len(valid | filter(#.region == "eu")),
  },
  us: {
    total: sum(valid | filter(#.region == "us") | map(#.amount)),
    count: len(valid | filter(#.region == "us")),
  },
  dropped: total - len(valid),
}
