@description "Lowercase projections work on typed Go fields without JSON tags"
@assert: result.stdout == "typed result"
@assert: result.exit_code == 0
@assert: result.ok == true
@assert: result.summary == "typed result"
@assert: result.root_stdout == "typed result"
@assert: result.nested.request_id == "request-42"
@assert: result.nested_request_id == "request-42"
@assert: result.indexed_request_id == "request-42"
@assert: result.root_indexed_request_id == "request-42"
@pipeline typed_go_fields
  cov.typed_projection as execution
  -> {
    stdout: execution.stdout,
    exit_code: execution.exit_code,
    ok: execution.ok,
    summary: execution.Summary(),
    root_stdout: .stdout,
    nested: execution.nested,
    nested_request_id: execution.nested.request_id,
    indexed_request_id: execution.items[0].request_id,
    root_indexed_request_id: .items[0].request_id
  }
@end
pipeline.typed_go_fields
