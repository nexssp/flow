# @syntax-only
@description "A valid namespaced function call in an atom argument compiles against the schema and executes"
@schema TypedArgumentValidInput {
  name string
}
@func commerce.echo(value string) string = value
@pipeline typed_argument_expression_valid
  :request-schema=!TypedArgumentValidInput
  {value: commerce.echo(.name)}
    -> pick(field: "value")
@end
pipeline.typed_argument_expression_valid
