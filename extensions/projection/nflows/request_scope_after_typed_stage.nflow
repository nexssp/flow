@description "input remains the original request while __root__ is the current typed stage"
@assert: original_request == "original request" && current_stage_stdout == "typed result" && bound_stage_stdout == "typed result"
@schema Request {
  request! string
}
@pipeline request_scope_after_typed_stage(request: Request)
  cov.typed_projection as typed
  -> {
    original_request: input.request,
    current_stage_stdout: __root__.stdout,
    bound_stage_stdout: typed.stdout
  }
@end
{ request: "original request" }
-> pipeline.request_scope_after_typed_stage
