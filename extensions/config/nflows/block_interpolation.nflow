@description "Select practical API settings for local development or production"
@config {
  environment: "dev" :cli="e,environment" :desc="dev or prod"
}
{
  environment: "@config.environment",
  endpoint: @config.environment == "prod" ? "https://api.example.test" : "http://127.0.0.1:8080",
  retry_limit: @config.environment == "prod" ? 5 : 1,
  tls_required: @config.environment == "prod"
}

@assert {
  environment == "dev" || environment == "prod"
  endpoint == (environment == "prod" ? "https://api.example.test" : "http://127.0.0.1:8080")
  retry_limit == (environment == "prod" ? 5 : 1)
  tls_required == (environment == "prod")
}
