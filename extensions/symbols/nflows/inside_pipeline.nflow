@description "Symbols: namespace usable inside a named @pipeline body"

@symbols thresholds {
  high_value: "1000"
  currency:   "USD"
}

@pipeline classify
  { amount: "1000" } -> match {
    .amount == thresholds.high_value -> const @{ value: "over_high_value" },
    _                                -> const @{ value: "under_high_value" }
  }
@end

{} -> pipeline.classify

@assert: result == "over_high_value"
