@description "spec: explicit symbol types preserve native values while legacy mapped and bare names remain strings"
@symbols http_status {
  ok: int = 200;
  created: int = 201;
  base_url: string = "https://api.internal";
  timeout: duration = 5s
}
@symbols legacy { ready: "needs_review" }
@symbols states { pending }
@symbols escaped {
  line: "line\nbreak";
  unicode: string = "\u{41}";
  byte: "\xff";
  raw: `line\nbreak`;
  single: 'line\nbreak'
}
{ status: http_status.created, base_url: http_status.base_url, timeout: http_status.timeout, legacy: legacy.ready, identity: states.pending, escaped_line: escaped.line, escaped_unicode: escaped.unicode, escaped_byte: escaped.byte, escaped_raw: escaped.raw, escaped_single: escaped.single }

@assert {
  status == 201
  base_url == "https://api.internal"
  timeout != nil
  legacy == "needs_review"
  identity == "pending"
  escaped_line == "line\nbreak"
  escaped_unicode == "A"
  escaped_byte == "ÿ"
  escaped_raw == "line\\nbreak"
  escaped_single == "line\\nbreak"
}
