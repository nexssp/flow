@description "Symbols: status set acts as a domain enumeration"

@symbols status {
  pending:   "PENDING"
  approved:  "APPROVED"
  rejected:  "REJECTED"
  completed: "COMPLETED"
}

{ state: "APPROVED" }
  -> match {
  .state == status.approved
    -> const "proceed",
  .state == status.pending
    -> const "wait",
  .state == status.rejected
    -> const "halt",
  _
    -> const "unknown"
}

@assert: result == "proceed"
