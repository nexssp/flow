@description "Symbols: status set acts as a domain enumeration"

@symbols status {
  pending:   "PENDING"
  approved:  "APPROVED"
  rejected:  "REJECTED"
  completed: "COMPLETED"
}

{ state: "APPROVED" } -> match {
  .state == status.approved  -> const @{ value: "proceed" },
  .state == status.pending   -> const @{ value: "wait" },
  .state == status.rejected  -> const @{ value: "halt" },
  _                          -> const @{ value: "unknown" }
}

@assert: result == "proceed"
