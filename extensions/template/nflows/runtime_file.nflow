@description "Render UTF-8 template source loaded from a runtime file"
@assert: result.succeeded == 1
@assert: result.items[0].ok == true
@assert: result.items[0].result == "Welcome Ada — Grüß Gott, 世界 🌍\n"
@pipeline render_runtime_template_file
  template.render @{ template_bytes: .Content, variables: { name: "Ada" } }
@end
fs.walk @{ dir: ".", ext: "tmpl" } -> fs.read -> collect -> { files: . } -> distribute.map @{ action: pipeline.render_runtime_template_file, items: .files }
