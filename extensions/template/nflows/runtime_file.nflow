@description "Render UTF-8 template source loaded from a runtime file"
@pipeline render_runtime_template_file
  template.render ( template_bytes: .Content, variables: { name: "Ada" } )
@end
fs.walk ( dir: ".", ext: "tmpl" )
  -> fs.read
  -> collect
  -> { files: . }
  -> distribute.map ( action: pipeline.render_runtime_template_file, items: .files )

@assert {
  succeeded == 1
  items[0].ok == true
  items[0].result == "Welcome Ada — Grüß Gott, 世界 🌍\n"
}
