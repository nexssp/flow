@description "Data shaping: pick, with, wrap compose without glue"

{
  id: 42,
  name: "alice",
  secret: "leaked",
  extra: "ignored",
}
-> pick ( only: ["id", "name"] )
-> with ( audited: true )
-> wrap ( key: "payload" )

@assert {
  payload.id == 42
  payload.name == "alice"
  payload.audited == true
  !("secret" in payload)
}
