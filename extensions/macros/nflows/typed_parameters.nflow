@description "Typed macro parameters validate and expand into executable flow syntax"
@macro make_record(key: Identifier, label: String, amount: Integer, seed: Expr, finish: ActionRef) {
  $seed -> { ..., $key: $amount, label: $label } -> $finish
}
@assert: result.count == 7 && result.label == "typed" && result.seed == true
@make_record(count, "typed", 7, const( seed: true ), runtime.noop)
