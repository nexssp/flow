@description "each maps list items in order and sees the current item and outer alias"

{ batch: "batch-7", samples: [
  { id: "first", score: 3 },
  { id: "second", score: 5 },
  { id: "third", score: 1 },
  ] } as source
-> pick ( field: "samples" )
-> each :concurrency=2 {
  { id: (.id), score: (.score * 2), batch: (source.batch) }
}

@assert {
  len(result) == 3
  result[0].id == "first" && result[0].score == 6 && result[0].batch == "batch-7"
  result[1].id == "second" && result[1].score == 10 && result[1].batch == "batch-7"
  result[2].id == "third" && result[2].score == 2 && result[2].batch == "batch-7"
}
