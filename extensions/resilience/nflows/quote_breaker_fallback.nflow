@require resilience {
  failure_threshold: "1"
  reset_timeout: "30s"
}
@description "Record a quote-provider outage behind a named local breaker and serve the cached quote"
@assert: result == "ACME/USD 41.90 (cached)"
fail @{ kind: "Unavailable", message: "quote service returned HTTP 503" } :circuit_breaker=quote-provider
|| const @{ value: "ACME/USD 41.90 (cached)" }
