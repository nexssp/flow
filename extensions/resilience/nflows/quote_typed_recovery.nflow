@require resilience
@description "Route only an unavailable quote provider to a deferred result"
@assert {
  status == "deferred"
  error_kind == "Unavailable"
}
fail ( kind: "Unavailable", message: "quote provider is temporarily offline" )
? on_error {
  xerr.KindUnavailable
  -> { status: "deferred", error_kind: "Unavailable" },
  else
  -> error.reraise
}
