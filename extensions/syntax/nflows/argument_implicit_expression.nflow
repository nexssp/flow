@description "Unwrapped action-argument expressions evaluate runtime values"
{ name: "Julia", score: 4, tags: ["nflow"] }
-> pipeline.argument_implicit_expression
@pipeline argument_implicit_expression
  noop as person
  -> noop(
    arithmetic: .score + 1,
    conditional: input.score > 3 ? "high" : "low",
    from_input: input.name,
    from_binding: person.name,
    greeting: "Hello, " + .name,
    length: len(.tags),
    nested: {
      double_score: person.score * 2,
      current_name: .name
    },
    values: [input.score + 2, person.score + 3, .],
    legacy_input: input.name,
    legacy_binding: person,
    legacy_path: person.name,
    literal: "input.name"
  )
@end

@assert {
  arithmetic == 5 && conditional == "high"
  from_input == "Julia" && from_binding == "Julia"
  nested.double_score == 8 && nested.current_name == "Julia"
  .values[0] == 6 && .values[1] == 7 && .values[2].name == "Julia"
  greeting == "Hello, Julia" && length == 1
  legacy_input == "Julia" && legacy_binding.name == "Julia" && legacy_path == "Julia"
  literal == "input.name"
}
