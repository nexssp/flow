@description "Typed literal starts and parenthesized named action arguments"
parallel {
  text: "42",
  count: 42,
  values: [1, "2", true],
  after_modifier: noop :timeout=3s (tag: "after-modifier"),
  wrapped: { person: "Julia" }
  -> wrap(key: "greeting"),
  ordinary: {value: "42", val: 7, coerce: true}
}

@assert {
  text == "42"
  .count == 42
  .values[0] == 1 && .values[1] == "2" && .values[2] == true
  wrapped.greeting.person == "Julia"
  ordinary.value == "42" && ordinary.val == 7 && ordinary.coerce == true
}
