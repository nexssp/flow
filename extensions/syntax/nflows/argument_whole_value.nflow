@description "Whole-value dot and expressions preserve scalar and collection current inputs"
@func whole_value.echo(value string) string = value
@pipeline argument_scope
  runtime.noop as person
  -> const (
    bare_input: input.name,
    bare_binding: person,
    bare_path: person.name,
    name,
    expression_input: whole_value.echo(input.name),
    expression_binding: whole_value.echo(person.name)
  )
@end
@pipeline scalar_passthrough
  runtime.noop
@end
@assert: result.text == "the exact scalar"
@assert: result.number == 37.5
@assert: result.boolean == false
@assert: result.null_value == nil
@assert: result.list[0] == 1 && result.list[1] == 2
@assert: result.nested.items[0] == "nested scalar"
@assert: result.expression == "expression scalar"
@assert: result.object.value.name == "Julia" && result.object.value.nested.count == 2 && result.object.first_name == "Julia"
@assert: result.named_pipeline.request == "the exact named scalar"
@assert: result.scope.bare_input == "input.name" && result.scope.bare_binding == "person"
@assert: result.scope.bare_path == "person.name"
@assert: result.scope.name == "Julia"
@assert: result.scope.expression_input == "Julia" && result.scope.expression_binding == "Julia"
parallel {
  text: const "the exact scalar"
    -> const(value: .) -> pick(field: "value"),
  number: const 37.5
    -> const(value: .) -> pick(field: "value"),
  boolean: const false
    -> const(value: .) -> pick(field: "value"),
  null_value: const null
    -> const(value: .) -> pick(field: "value"),
  list: const(value: [1, 2])
    -> pick(field: "value")
    -> const(value: .) -> pick(field: "value"),
  nested: const "nested scalar"
    -> const( items: [.] ),
  expression: const "expression scalar"
    -> const(value: whole_value.echo(.)) -> pick(field: "value"),
  named_pipeline: const "the exact named scalar"
    -> pipeline.scalar_passthrough ( request: . ),
  object: { name: "Julia", nested: { count: 2 } }
    -> runtime.noop ( value: ., first_name: .name ),
  scope: { name: "Julia" }
    -> pipeline.argument_scope
}
