@description "if branches see current input, original input, and outer aliases without leaking local bindings"
@assert: result.selected == "inner" && result.original == "original" && result.outer_still_visible == true
@pipeline if_scope
  { enabled: true } as outer
  -> if (.enabled && input.request == "original" && outer.enabled == true) {
    "inner" as outer
    -> { selected: ., original: input.request, branch_binding: outer }
  } else {
    fail ( message: "true condition selected the else branch" )
  }
  -> { selected: .selected, original: .original, outer_still_visible: outer.enabled }
@end
{ request: "original" }
  -> pipeline.if_scope
