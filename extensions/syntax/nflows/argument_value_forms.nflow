@description "Argument values cover scalar, collection, nested, and reference forms"
{ input: { name: "Ada" }, tags: ["root"] }
-> {
  text: "quoted: value",
  count: 3,
  enabled: true,
  empty: null,
  items: ["one", 2, false, null],
  nested: { from: .input.name, whole: . }
}

@assert {
  text == "quoted: value"
  .count == 3 && enabled == true && empty == nil
  items[0] == "one" && items[1] == 2 && items[2] == false && items[3] == nil
  nested.from == "Ada" && nested.whole.input.name == "Ada"
}
