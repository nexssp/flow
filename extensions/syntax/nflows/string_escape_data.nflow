@description "Double-quoted runtime strings decode consistently; backticks stay raw and single quotes keep legacy behavior"
@assert {
  result.line == "line\nbreak"
  result.expression == "line\nbreak"
  result.raw == `line\nbreak`
  result.unicode == "A"
  result.unicode_expression == "A"
  result.byte == "ÿ"
  result.action_line == "line\nbreak"
  result.action_unicode == "A"
  result.action_byte == "ÿ"
  result.action_raw == `line\nbreak`
  result.action_single == `line\nbreak`
  result.action_nested.line == "line\nbreak"
  result.action_array[0] == "A"
  result.action_array[1] == "ÿ"
  result.action_array[2] == `line\nbreak`
}
runtime.noop(
  action_line: "line\nbreak",
  action_unicode: "\u{41}",
  action_byte: "\xff",
  action_raw: `line\nbreak`,
  action_single: 'line\nbreak',
  action_nested: { line: "line\nbreak" },
  action_array: ["\u{41}", "\xff", `line\nbreak`]
) -> {
  line: "line\nbreak",
  expression: ("line\nbreak"),
  raw: `line\nbreak`,
  unicode: "\u{41}",
  unicode_expression: ("\u{41}"),
  byte: "\xff",
  action_line,
  action_unicode,
  action_byte,
  action_raw,
  action_single,
  action_nested,
  action_array
}
