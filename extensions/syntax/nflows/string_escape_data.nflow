@description "Data strings preserve backslashes while expr-lang handles expression escapes"
@assert {
  result.line == "line\\nbreak"
  result.unknown == "unknown\\q"
  result.hex == "bad hex\\xGG"
  result.unicode == "bad unicode\\uZZZZ"
  len("\n") == 1
}
const(
  line: "line\nbreak",
  unknown: "unknown\q",
  hex: "bad hex\xGG",
  unicode: "bad unicode\uZZZZ"
)
