@description "Atom annotations are carried into the downstream action request"
noop #alpha,beta ~legacy,untrusted @review ( request: "kept" )

@assert {
  request == "kept"
  prompt == "review"
  targets[0] == "alpha" && targets[1] == "beta"
  excludes[0] == "legacy" && excludes[1] == "untrusted"
}
