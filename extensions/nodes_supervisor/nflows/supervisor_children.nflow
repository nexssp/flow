# @syntax-only
@description "Supervisor: concurrent child pipelines with per-child isolation"

# Each child has its own DSL, its own payload, and its own error budget.
# A failing child does not stop its siblings. Results preserve input order.

@schema SupervisorChildTask struct {
  ID string `json:"id" validate:"required"`
  DSL string `json:"dsl" validate:"required"`
  Payload any `json:"payload"`
  TimeoutMS int64 `json:"timeout_ms,omitempty"`
}

@schema SupervisorInput struct {
  Tasks []SupervisorChildTask `json:"tasks" validate:"required,min=1"`
}

@assert: result.total == 3
@assert: result.succeeded == 2
@assert: result.failed == 1
@assert: result.results[0].task_id == "num"
@assert: result.results[0].output == 42
@assert: result.results[1].task_id == "boom"
@assert: result.results[2].task_id == "echo"
@assert: result.results[2].output.greeting == "hi"

@pipeline supervisor_children
  :request-schema=!SupervisorInput
  { tasks: .tasks }
  -> supervisor.run
@end
pipeline.supervisor_children
