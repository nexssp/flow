# @syntax-only
@description "Supervisor: concurrent child pipelines with per-child isolation"

# Each child has its own DSL, its own payload, and its own error budget.
# A failing child does not stop its siblings. Results preserve input order.

@schema SupervisorChildTask struct {
  id! string
  dsl! string
  payload any
  timeout_ms int64
}

@schema SupervisorInput struct {
  tasks! []SupervisorChildTask `validate:"min=1"`
}

@pipeline supervisor_children(request: !SupervisorInput)
  { tasks: .tasks }
  -> supervisor.run
@end
pipeline.supervisor_children

@assert {
  total == 3
  succeeded == 2
  failed == 1
  results[0].task_id == "num"
  results[0].output == 42
  results[1].task_id == "boom"
  results[2].task_id == "echo"
  results[2].output.greeting == "hi"
}
