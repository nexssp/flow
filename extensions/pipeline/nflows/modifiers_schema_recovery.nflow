@description "spec: pipeline multiline modifiers and schema guard recovery"

@schema SupportTicket {
  ticket_id! string
  priority! string
}

@pipeline triage
  :tag="support"
  :status=200

  SupportTicket.validate ? on_error {
    xerr.KindValidation
    -> {
      status: "rejected",
      error:  .error.message
    }
  }
  -> {
    status:    "accepted",
    ticket_id: .ticket_id,
    queue:     "tier1-" + .priority
  }
@end

{ ticket_id: "TCK-101", priority: "high" }
-> pipeline.triage

@assert {
  status == "accepted"
  ticket_id == "TCK-101"
  queue == "tier1-high"
}
