@description "spec: request-schema=[]Item applies defaults and validates every input item"
@schema Item {
  name! string
  role! string `default:"guest"`
}
@pipeline items(request: []Item)
  noop
@end
{value: [{ name: "Ada" }, { name: "Lin", role: "member" }]}
  -> pick(field: "value")
-> pipeline.items

@assert {
  result[0].role == "guest"
  result[1].role == "member"
}
