@description "spec: request-schema=[]Item applies defaults and validates every input item"
@schema Item {
  Name string `json:"name" validate:"required"`
  Role string `json:"role" default:"guest" validate:"required"`
}
@pipeline items
  :request-schema=[]Item
  runtime.noop
@end
{value: [{ name: "Ada" }, { name: "Lin", role: "member" }]}
  -> pick(field: "value")
-> pipeline.items
@assert: result[0].role == "guest"
@assert: result[1].role == "member"
