@description "spec: duplicate legacy request contract declarations with conflicting schemas fail compilation"
@schema FirstRequest {
  name string
}
@schema SecondRequest {
  name string
}
@pipeline invalid(req: FirstRequest)
  :request-schema=FirstRequest
  :request-schema=SecondRequest
  noop
@end
pipeline.invalid
# @expect-compile-error conflicting duplicate :request-schema declarations
