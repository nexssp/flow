@description "spec: typed pipeline input and output contracts validate strict request and response boundaries"
@schema CreateRequest {
  Name string `json:"name" validate:"required"`
}
@schema CreateResponse {
  Name string `json:"name" validate:"required"`
}
@pipeline create_order(req: !CreateRequest): !CreateResponse
  noop
@end
const @{ value: { name: "Ada" } }
  -> pipeline.create_order
@assert: result.name == "Ada"
