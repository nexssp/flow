@description "spec: a named typed request binding validates and reaches the pipeline body"
@schema CreateRequest {
  name! string
  region string `default:"US"`
}
@schema CreateResponse {
  name! string
}
@pipeline create_order(order_req: !CreateRequest): !CreateResponse
  {name: (order_req.region)}
@end
{ name: "Ada" }
  -> pipeline.create_order
@assert: name == "US"
