@description "spec: typed []Item response rejects a non-array top-level result"
@schema Item {
  name! string
}
@pipeline items(): []Item
  { name: "not-an-array" }
@end
pipeline.items ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: result.rejected == true
