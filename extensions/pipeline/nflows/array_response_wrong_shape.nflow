@description "spec: response-schema=[]Item rejects a non-array top-level result"
@schema Item {
  Name string `json:"name" validate:"required"`
}
@pipeline items
  :response-schema=[]Item
  runtime.const @{ value: { name: "not-an-array" } }
@end
pipeline.items ? on_error {
  xerr.KindValidation
    -> { rejected: true },
  else
    -> error.reraise
}
@assert: result.rejected == true
