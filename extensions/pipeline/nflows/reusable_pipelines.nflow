@description "Pipelines: named fragments compose like actions"

@pipeline extract_user
  pick @{ field: "user" }
@end

@pipeline stamp
  with @{ stamped: true }
@end

@assert: result.id == 42
@assert: result.stamped == true

{ user: { id: 42, name: "alice" } }
-> pipeline.extract_user
-> pipeline.stamp
