@description "spec: strict typed ![]Item response rejects undeclared object fields in array items"
@schema Item {
  name! string `validate:"required"`
}
@pipeline items(): ![]Item
  {value: [{ name: "Ada", extra: true }]}
    -> pick(field: "value")
@end
pipeline.items ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: result.rejected == true
