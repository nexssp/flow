@description "spec: typed []Item response rejects an invalid array item"
@schema Item {
  name! string `validate:"required"`
}
@pipeline items(): []Item
  {value: [{ name: "" }]}
    -> pick(field: "value")
@end
pipeline.items ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: result.rejected == true
