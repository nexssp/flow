@description "spec: typed []Item response validates each object and preserves the array result"
@schema Item {
  name! string
}
@pipeline items(): []Item
  {value: [{ name: "Ada" }, { name: "Lin" }]}
    -> pick(field: "value")
@end
pipeline.items

@assert {
  result[0].name == "Ada"
  result[1].name == "Lin"
}
