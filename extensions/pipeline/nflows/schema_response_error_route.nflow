@description "Outer @on_error routes called-pipeline response schema validation by TaskResponse message prefix"

@schema TaskRequest {
  Email string `json:"email" validate:"required,email"`
  Title string `json:"title" validate:"required"`
}
@schema TaskResponse {
  ID string `json:"id" validate:"required"`
}

@pipeline create_task
  :request-schema=TaskRequest
  :response-schema=TaskResponse
  # This local catch wraps only the body. Response validation happens after
  # the body returns, outside this catch, so the outer route must recover it.
  @on_error {
    when error.kind == xerr.KindValidation -> pipeline.inner_body_recovery
  }
  const @{ task_id: "task-1" }
@end

@pipeline inner_body_recovery
  const @{ route: "inner-body-catch" }
@end
@pipeline request_schema_recovery
  const @{ route: "request-schema", kind: "Validation" }
@end
@pipeline email_field_recovery
  const @{ route: "email-field", kind: "Validation" }
@end
@pipeline response_schema_recovery
  const @{ route: "response-schema", kind: "Validation" }
@end

@on_error {
  when error.kind == xerr.KindValidation and error.message startsWith "schema TaskRequest" and error.details[0].Field == "email" -> pipeline.email_field_recovery,
  when error.kind == xerr.KindValidation and error.message startsWith "schema TaskRequest" -> pipeline.request_schema_recovery,
  when error.kind == xerr.KindValidation and error.message startsWith "schema TaskResponse" -> pipeline.response_schema_recovery,
  else -> error.info
}

{ email: "alex@example.com", title: "Boundary test" } -> pipeline.create_task

@assert: result.route == "response-schema"
@assert: result.kind == "Validation"
