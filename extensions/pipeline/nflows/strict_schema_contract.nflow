@description "The ! prefix makes request and response schema boundaries strict independently"

@schema StrictRequest {
  Name string `json:"name" validate:"required"`
}
@schema StrictResponse {
  Message string `json:"message" validate:"required"`
}

@pipeline greet_strict
  :request-schema=!StrictRequest
  :response-schema=!StrictResponse
  { message: .name }
@end

{ name: "Ada" } -> pipeline.greet_strict
@assert: result.message == "Ada"
