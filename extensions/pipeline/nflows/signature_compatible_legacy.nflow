@description "spec: identical signature and legacy request/response contracts coexist during migration"
@schema DualRequest {
  Name string `json:"name" validate:"required"`
}
@schema DualResponse {
  Name string `json:"name" validate:"required"`
}
@pipeline compatible(req: !DualRequest): !DualResponse
  :request-schema=!DualRequest
  :response-schema=!DualResponse
  noop
@end
const(name: (input.name ?? "dual"))
  -> pipeline.compatible
@assert: result.name == "dual"
