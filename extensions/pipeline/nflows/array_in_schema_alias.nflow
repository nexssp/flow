@description "spec: strict in-schema array alias rejects undeclared item fields"
@schema Item {
  name! string
}
@pipeline items
  :in-schema=![]Item
  noop
@end
{value: [{ name: "Ada", extra: true }]}
  -> pick(field: "value")
-> pipeline.items ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: rejected == true
