@description "Config-backed timeout modifiers are inherited by an executable loop in a materialized pipeline"
@config {
  pipeline_timeout: "240s"
}
@pipeline configured_loop :timeout=@config.pipeline_timeout
  loop({ n: .n + 1 }) until(.n >= 1)
@end
{ n: 0 } -> pipeline.configured_loop
@assert: result.n == 1
