@description "spec: shared schema=[]Item validates both input and output arrays"
@schema Item {
  Name string `json:"name" validate:"required"`
}
@pipeline echo
  :schema=[]Item
  runtime.noop
@end
const(value: [{ name: "Ada" }, { name: "Lin" }])
  -> pick(field: "value")
-> pipeline.echo
@assert: result[0].name == "Ada"
@assert: result[1].name == "Lin"
