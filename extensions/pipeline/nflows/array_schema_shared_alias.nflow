@description "spec: shared schema=[]Item validates both input and output arrays"
@schema Item {
  name! string
}
@pipeline echo
  :schema=[]Item
  noop
@end
{value: [{ name: "Ada" }, { name: "Lin" }]}
  -> pick(field: "value")
-> pipeline.echo

@assert {
  result[0].name == "Ada"
  result[1].name == "Lin"
}
