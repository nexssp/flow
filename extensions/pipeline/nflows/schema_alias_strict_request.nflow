@description "spec: strict :in-schema rejects unknown fields at the request boundary"
@schema ChatTurn {
  role!    string
  content! string
}
@pipeline strict_input
  :in-schema=!ChatTurn
  noop
@end
@pipeline request_rejected
  { route: "strict-request-rejected" }
@end
@on_error {
  when error.kind == xerr.KindValidation -> pipeline.request_rejected,
  else -> error.info
}
{ role: "assistant", content: "hello", unexpected: true }
  -> pipeline.strict_input
@assert: route == "strict-request-rejected"
