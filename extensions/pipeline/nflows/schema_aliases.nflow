@description "spec: source-imported qualified schemas resolve through strict :in-schema and :out-schema aliases"
@include ./types.nflow AS memory
@pipeline validate_memory
  :in-schema=!memory.ChatTurn
  :out-schema=memory.ChatTurn
  noop
@end
{ role: "assistant", content: "symbols and schemas" }
  -> pipeline.validate_memory

@assert {
  role == "assistant"
  content == "symbols and schemas"
}
