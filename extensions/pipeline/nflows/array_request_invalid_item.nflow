@description "spec: request-schema=[]Item rejects an invalid input item"
@schema Item {
  name! string
}
@pipeline items(request: []Item)
  noop
@end
{value: [{}]}
  -> pick(field: "value")
-> pipeline.items ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: rejected == true
