@description "spec: typed symbols remain native across request defaults and response validation boundaries"
@symbols boundary_values {
  status: int = 201;
  timeout: duration = 5s
}
@schema TypedRequest {
  status  int `default:"boundary_values.status" validate:"eq=boundary_values.status"`
  timeout duration `default:"boundary_values.timeout" validate:"gte=boundary_values.timeout"`
}
@schema TypedResponse {
  status  int `validate:"eq=boundary_values.status"`
  timeout duration `validate:"gte=boundary_values.timeout"`
}
@pipeline typed_boundary(request: TypedRequest): TypedResponse
  noop
@end
@pipeline typed_invalid_response(): TypedResponse
  { status: 202, timeout: boundary_values.timeout }
@end
pipeline.typed_boundary
