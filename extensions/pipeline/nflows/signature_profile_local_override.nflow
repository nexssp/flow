@description "spec: pipeline-local schemas override inherited profile defaults when the profile appears first"
@schema ProfileRequest {
  name! string
}
@schema ProfileResponse {
  name! string
}
@schema LocalRequest {
  name! string
}
@schema LocalResponse {
  name! string
}
@profile base_defaults
  :request-schema=!ProfileRequest
  :response-schema=!ProfileResponse
@profile defaults
  :parent=base_defaults
@pipeline profile_before_local(req: !LocalRequest): !LocalResponse
  :profile=defaults
  :request-schema=!LocalRequest
  :response-schema=!LocalResponse
  noop
@end
{ name: "Ada" }
  -> pipeline.profile_before_local
@assert: name == "Ada"
