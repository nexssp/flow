@description "spec: pipeline-local schema modifiers win when inherited profile defaults appear later in the header"
@schema ProfileRequest {
  name! string
}
@schema ProfileResponse {
  name! string
}
@schema LocalRequest {
  name! string
}
@schema LocalResponse {
  name! string
}
@profile base_defaults
  :request-schema=!ProfileRequest
  :response-schema=!ProfileResponse
@profile defaults
  :parent=base_defaults
@pipeline local_before_profile(req: !LocalRequest): !LocalResponse
  :request-schema=!LocalRequest
  :response-schema=!LocalResponse
  :profile=defaults
  noop
@end
{ name: "Lin" }
  -> pipeline.local_before_profile
@assert: name == "Lin"
