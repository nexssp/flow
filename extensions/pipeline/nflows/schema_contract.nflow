@description "Pipeline request schemas apply defaults; permissive response schemas validate and preserve extra fields"
@schema ContractRequest {
  name!  string `default:"Guest"`
  depth int `default:"1" validate:"gte=1"`
}
@schema ContractResponse {
  message!  string
  optional string
}
@pipeline greet(request: ContractRequest): ContractResponse
  {
    message: .name,
    state: { depth: .depth },
    extra: "kept"
  }
@end
{}
  -> pipeline.greet
@assert {
  message == "Guest"
  state.depth == 1
  extra == "kept"
  result.optional == nil
}
