@description "spec: request-schema=[]int rejects a scalar item with the wrong type"
@pipeline numbers
  :request-schema=[]int
  runtime.noop
@end
const(value: ["not an integer"])
  -> pick(field: "value")
-> pipeline.numbers ? on_error {
  xerr.KindValidation
    -> { rejected: true },
  else
    -> error.reraise
}
@assert: result.rejected == true
