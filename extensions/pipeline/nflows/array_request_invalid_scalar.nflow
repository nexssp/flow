@description "spec: request-schema=[]int rejects a scalar item with the wrong type"
@pipeline numbers(request: []int)
  noop
@end
{value: ["not an integer"]}
  -> pick(field: "value")
-> pipeline.numbers ? on_error {
  xerr.KindValidation
  -> { rejected: true },
  else
  -> error.reraise
}
@assert: rejected == true
