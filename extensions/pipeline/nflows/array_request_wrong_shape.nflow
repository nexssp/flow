@description "spec: request-schema=[]Item rejects a non-array input"
@schema Item {
  Name string `json:"name" validate:"required"`
}
@pipeline items
  :request-schema=[]Item
  runtime.noop
@end
const @{ value: { name: "Ada" } }
-> pipeline.items ? on_error {
  xerr.KindValidation
    -> { rejected: true },
  else
    -> error.reraise
}
@assert: result.rejected == true
