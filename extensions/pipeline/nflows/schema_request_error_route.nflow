@description "Outer @on_error routes called-pipeline request schema validation by TaskRequest message prefix"

@schema TaskRequest {
  email! string `validate:"email"`
  title! string
}
@schema TaskResponse {
  id! string
}

@pipeline create_task(request: TaskRequest): TaskResponse
  # This local catch wraps only the body. Request and response boundaries
  # surround the pipeline call and must be caught by the outer directive.
  @on_error {
    when error.kind == xerr.KindValidation -> pipeline.inner_body_recovery
  }
  { id: "task-1" }
@end

@pipeline inner_body_recovery
  { route: "inner-body-catch" }
@end
@pipeline request_schema_recovery
  { route: "request-schema", kind: "Validation" }
@end
@pipeline email_field_recovery
  { route: "email-field", kind: "Validation" }
@end
@pipeline response_schema_recovery
  { route: "response-schema", kind: "Validation" }
@end

@on_error {
  when error.kind == xerr.KindValidation and error.message startsWith "schema TaskRequest" and error.details[0].Field == "email" -> pipeline.email_field_recovery,
  when error.kind == xerr.KindValidation and error.message startsWith "schema TaskRequest" -> pipeline.request_schema_recovery,
  when error.kind == xerr.KindValidation and error.message startsWith "schema TaskResponse" -> pipeline.response_schema_recovery,
  else -> error.info
}

{ email: "alex@example.com" }
  -> pipeline.create_task

@assert {
  route == "request-schema"
  kind == "Validation"
}
