@description "Pipeline header accepts clean indented multi-line modifiers"

@schema JobPayload {
  job_id!    string
  priority int `default:"5" validate:"gte=1"`
}

@pipeline process_job(request: JobPayload)
  :timeout=3s
  :tag="worker,batch"
  :status=201

  {
    processed_id: .job_id,
    prio:         .priority,
    ack:          true
  }
@end

{ job_id: "JOB-404" }
-> pipeline.process_job

@assert {
  processed_id == "JOB-404"
  prio == 5
  ack == true
}
