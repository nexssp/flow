@config:budget_usd=0.05
@llm thinker { provider: "deepseek", model: "deepseek-chat" }

{
  system: "Jesteś ekspertem. Odpowiedz krótko.",
  user: .problem,
  attempt: 1
}
-> loop(
     # Wołamy model
     llm.thinker

     # Rzutujemy wynik do wejścia na kolejną pętlę (symulacja "popraw się")
     -> {
          system: "To jeszcze nie to. Popraw się.",
          user: .content,
          attempt: attempt + 1
        }
   ) until( attempt >= 3 )

-> { final_answer: .user, total_attempts: .attempt }
