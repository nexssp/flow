@description "Production-shaped polyglot order ingestion: schemas, macros, Python normalization, and Kernel-backed bounded fan-out."
@require lang

# This example uses the opt-in lang bundle's built-in py3 runner.

@schema OrderBatch {
    Orders  []any  `json:"orders" validate:"required"`
}

@schema InboundOrder {
    BatchID        string `json:"batch_id" validate:"required"`
    OrderID        string `json:"order_id" validate:"required"`
    CustomerID     string `json:"customer_id" validate:"required"`
    AmountCents    int    `json:"amount_cents" validate:"gt=0"`
    Currency       string `json:"currency" validate:"required,len=3"`
    IdempotencyKey string `json:"idempotency_key"`
}

@schema NormalizedOrder {
    BatchID        string `json:"batch_id" validate:"required"`
    OrderID        string `json:"order_id" validate:"required"`
    CustomerID     string `json:"customer_id" validate:"required"`
    AmountCents    int    `json:"amount_cents" validate:"gt=0"`
    Currency       string `json:"currency" validate:"required,len=3"`
    IdempotencyKey string `json:"idempotency_key" validate:"required"`
}

@schema BatchResult {
    Items     []any `json:"items" validate:"required"`
    Succeeded int   `json:"succeeded" validate:"gte=0"`
    Failed    int   `json:"failed" validate:"gte=0"`
}

# Normalization is pure; idempotency belongs on any downstream write action.
@profile safe_transform :timeout=5s :retry=0

# One macro centralizes a required-field guard for reuse across pipelines.
@macro require_field(name) {
    assert(.$name != nil && .$name != "", "$name is required")
}

@pipeline normalize_order
    :request-schema=InboundOrder
    :response-schema=NormalizedOrder
    :profile=safe_transform
    :tag="orders.normalize"
    @require_field(order_id)
    -> @require_field(customer_id)
    -> @require_field(currency)
    -> py3 {
import json
import sys

order = json.load(sys.stdin)

# Validate and normalize at the language boundary; emit JSON only on stdout.
def required_text(name):
    value = order.get(name)
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{name} is required")
    return value.strip()

amount = order.get("amount_cents")
if isinstance(amount, bool) or not isinstance(amount, int) or amount <= 0:
    raise ValueError("amount_cents must be a positive integer")

order_id = required_text("order_id").upper()
currency = required_text("currency").upper()
if len(currency) != 3:
    raise ValueError("currency must be a three-letter code")

normalized = {
    "batch_id": required_text("batch_id"),
    "order_id": order_id,
    "customer_id": required_text("customer_id"),
    "amount_cents": amount,
    "currency": currency,
    "idempotency_key": (order.get("idempotency_key") or order_id).strip(),
}
print(json.dumps(normalized, separators=(",", ":")))
}
@end

# Fan-out executes the local normalization pipeline with bounded concurrency.
# Kernel's distribute.map applies the per-item timeout, retry and shared rate
# limiter, preserves input order, and fails the batch on any item error here.
@pipeline process_batch
    :request-schema=OrderBatch
    :response-schema=BatchResult
    :tag="orders.ingest"
    OrderBatch.validate
    -> distribute.map @{
        action: pipeline.normalize_order,
        items: .orders,
        concurrency: 4,
        rate_limit: 20,
        timeout_ms: 5000,
        retries: 1,
        fail_fast: true
    }
@end

# Pass the JSON request supplied to `nflow run` directly into the entry pipeline.
pipeline.process_batch
# Input contract: `orders` is a non-empty array; each item carries batch_id,
# order_id, customer_id, amount_cents, and currency. idempotency_key is optional.
