@description "Run independent actions concurrently"
@assert: result["runtime.const#1"] == "Data A"
@assert: result["runtime.const#2"] == "Data B"
@assert: result["runtime.noop"].request == "local input"
{ request: "local input" }
-> ( runtime.const @{ value: "Data A" } & runtime.noop & runtime.const @{ value: "Data B" } )
