@description "High-Throughput Parallel Processing (Scatter-Gather)"

# The '&' operator executes nodes concurrently on separate goroutines.
# Duplicate action names receive deterministic keys: runtime.sleep#1, runtime.sleep#2, runtime.sleep#3.
# The runtime.sleep action returns its request, so the projection.project selects .value.

@assert: result.a == "Data A"
@assert: result.b == "Data B"
@assert: result.c == "Data C"

(
    runtime.sleep @{ duration_ms: 500, value: "Data A" }
  & runtime.sleep @{ duration_ms: 500, value: "Data B" }
  & runtime.sleep @{ duration_ms: 500, value: "Data C" }
)
-> {
    a: .["runtime.sleep#1"].value,
    b: .["runtime.sleep#2"].value,
    c: .["runtime.sleep#3"].value
}
