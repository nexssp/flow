@description "High-Throughput Parallel Processing (Scatter-Gather)"

# 💡 TIP: The '&' operator executes nodes concurrently on separate goroutines.
# Watch the execution trace output to see that 3x 500ms tasks complete in exactly ~500ms total, not 1500ms!

@assert: result.a == "Data A"
@assert: result.b == "Data B"
@assert: result.c == "Data C"

# Scatter: Run 3 simulated API calls perfectly in parallel
(
    sleep @{ duration_ms: 500, value: "Data A" }
  & sleep @{ duration_ms: 500, value: "Data B" }
  & sleep @{ duration_ms: 500, value: "Data C" }
)

# Gather: Combine their outputs dynamically
-> {
    a: .branch_0.value,
    b: .branch_1.value,
    c: .branch_2.value
}
