@description "Enterprise Resilience: Automatic Retries and Catch Blocks"

# 💡 TIP: Production pipelines break. Nexss Flow provides Native Retries and Error Catching.
# 1. :retry=3 automatically retries with exponential backoff on failure.
# 2. @on_error allows pattern matching on error types.

@on_error {
  when error.kind == "Timeout" -> { message: "Caught a timeout!", handled: true }
  when error.kind == "Validation" -> { message: "Caught a validation error!", handled: true }
  else -> error.info
}

@assert: result.handled == true

# This action intentionally fails with a Validation error.
# The @on_error block catches it instantly and reroutes it!
fail @{ kind: "Validation", message: "User email is invalid" }
