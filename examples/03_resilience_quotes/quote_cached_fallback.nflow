@require resilience {
  default_max: "3"
  backoff: "exponential_jitter"
  min_backoff: "10ms"
  max_backoff: "2s"
  failure_threshold: "1"
  reset_timeout: "30s"
}
@description "Serve the last-known ACME/USD quote when the primary HTTP service is unavailable"
@assert: result == "ACME/USD 41.90 (last known)"
quote.primary :retry=0 :circuit_breaker=quote-provider || const @{ value: "ACME/USD 41.90 (last known)" }
