@require resilience {
  default_max: "1"
  backoff: "constant"
  min_backoff: "1ms"
  max_backoff: "1ms"
  failure_threshold: "1"
  reset_timeout: "30s"
}
@description "Retry a timed-out quote HTTP attempt; the breaker sees the completed operation"
@assert: result == "ACME/USD 42.10"
quote.primary :retry :timeout=25ms :circuit_breaker=quote-provider
