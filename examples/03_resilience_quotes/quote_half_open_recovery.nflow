@require resilience {
  default_max: "3"
  backoff: "exponential_jitter"
  min_backoff: "10ms"
  max_backoff: "2s"
  failure_threshold: "1"
  reset_timeout: "30s"
}
@description "After the recovery window, one quote request probes the primary service"
@assert: result == "ACME/USD 42.10"
quote.primary :circuit_breaker=quote-provider
