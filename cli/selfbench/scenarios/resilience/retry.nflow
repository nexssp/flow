@require resilience {
  default_max: "1"
  backoff: "constant"
  min_backoff: "1ms"
  max_backoff: "1ms"
  retry_all: "true"
  failure_threshold: "1"
  reset_timeout: "30s"
}
@description "Retry benchmark: one bounded retry with a 1ms constant backoff, then local recovery"
@assert: result == "recovered"
fail @{ kind: "BadRequest", message: "deterministic retry benchmark failure" } :retry=1
|| const @{ value: "recovered" }
