@description "Support triage: route a duplicate-charge ticket and prepare a safe reply draft"

@require ./bundle

@include ./common/triage.nflow

@assert: result.ticket_id == "SUP-5821"
@assert: result.priority == "urgent"
@assert: result.queue == "billing-escalations"
@assert: result.reply_status == "draft"
@assert: result.reply_text != nil
{
  ticket_id: "SUP-5821",
  customer_id: "cus-2048",
  subject: "Charged twice for one order",
  message: "I see two pending charges for order SO-2048."
}
-> triage.pipeline.triage
