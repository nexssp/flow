@description "Support triage: preserve a ticket for manual review when customer lookup is unavailable"
@require ./bundle

@include ./common/triage.nflow

@assert: result.ticket_id == "SUP-9901"
@assert: result.customer_id == "offline-customer-99"
@assert: result.status == "manual_review"
@assert: result.queue == "customer-success-manual"
@assert: result.reply_status == "draft_not_sent"
{
  ticket_id: "SUP-9901",
  customer_id: "offline-customer-99",
  subject: "Payment status unclear",
  message: "Please check whether the charge completed."
}
-> triage.pipeline.triage
